{
  "name": "fermat",
  "version": "0.0.0-semantic-release",
  "description": "Fermat's probabilistic primality test",
  "keywords": [
    "math",
    "primality"
  ],
  "license": "MIT",
  "author": "Kenan Yildirim <kenan@kenany.me> (https://kenany.me/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenany/fermat.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "types": "dist/index.d.cts",
  "main": "dist/index.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.cjs": {
      "default": "./dist/*.cjs"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "engines": {
    "node": "^22.12.0 || 24 || >=26"
  },
  "scripts": {
    "build": "tsdown && tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run",
    "publint": "publint --strict",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "bn": "^1.0.5",
    "lodash.isstring": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@containerbase/semantic-release-pnpm": "1.4.4",
    "@kenan/biome-config": "1.5.0",
    "carmichaels": "2.0.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "publint": "0.3.25",
    "semantic-release": "26.0.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
